{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smart-menu-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-07",
	"r2_buckets": [
		{
			"bucket_name": "smart-menu-assets",
			"binding": "smart_menu_assets",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "smart_menu_db",
			"database_name": "smart-menu-db",
			"database_id": "b047ae1b-af71-412c-a06f-1b60d2d2d16f",
			"remote": true
		}
	]
